{
  "$schema": "https://opencode.ai/config.json",
  "model": "amazon-bedrock/us.anthropic.claude-sonnet-4-6",
  "small_model": "amazon-bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0",
  "default_agent": "build",
  "agent": {
    "title": { "model": "amazon-bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0" }
  },
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-east-1"
      }
    }
  },
  "mcp": {
    "vendorvault": {
      "type": "remote",
      "url": "http://localhost:9001/agents/opencode/mcp",
      "enabled": true
    }
  }
}
