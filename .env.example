# Copy to .env (git ignores .env) and fill in.

# Amazon Bedrock API key for the vault agent's answers (optional: local search is used without it)
AWS_BEARER_TOKEN_BEDROCK=

# AWS region for Bedrock and Amazon Cognito
AWS_REGION=us-east-1

# Amazon Cognito enterprise login.
# The servers need no AWS keys at runtime: they read cognito.json, which the one-time setup writes.
# Set VV_COGNITO=off to fall back to the simulated logins.
VV_COGNITO=on

# Only for the one-time setup (python -m scripts.setup_cognito): AWS credentials that can manage Cognito.
# Leave these commented out if `aws configure` / AWS_PROFILE already works.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
